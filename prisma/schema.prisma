// שיטת מיכו - סכימת מסד נתונים
// שימוש ב-SQLite כדי שהפרויקט ירוץ מקומית בלי צורך להתקין שרת DB.
// להעברה ל-PostgreSQL בפרודקשן: שנה datasource ל-"postgresql" ועדכן DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Config {
  id                   Int      @id @default(1)
  portfolioValue       Float    @default(100000)
  maxRiskPerTradePct   Float    @default(1.0)
  maxPositionSizePct   Float    @default(20.0)

  closeDistancePct     Float    @default(5)
  mediumDistancePct    Float    @default(10)
  farDistancePct       Float    @default(20)

  volumeMultiplierMin  Float    @default(1.5)
  slopeLookbackDays    Int      @default(20)
  slopeUpThreshold     Float    @default(0.5)
  slopeDownThreshold   Float    @default(-0.5)

  entryBufferPct       Float    @default(0.5)
  ma150StopBufferPct   Float    @default(2.0)
  swingLowBufferPct    Float    @default(1.0)
  atrMultiplier        Float    @default(2.0)
  maxAcceptableRiskPct Float    @default(8.0)

  closeStrengthRatio   Float    @default(0.6)
  lowerLowLookbackDays Int      @default(5)
  breakoutLookbackDays Int      @default(20)

  updatedAt            DateTime @updatedAt
}

model IndexConstituent {
  id           Int      @id @default(autoincrement())
  ticker       String
  indexName    String   // "SP500" | "NASDAQ100"
  companyName  String?
  addedAt      DateTime @default(now())
  lastSyncedAt DateTime @default(now())

  @@unique([ticker, indexName])
}

model StockSnapshot {
  ticker         String   @id
  companyName    String?
  price          Float?
  ma150          Float?
  ma150SlopePct  Float?
  volume         Float?
  avgVolume20d   Float?
  atr14          Float?
  swingLow       Float?
  recentHigh     Float?
  madeLowerLow   Boolean?
  candleClose    Float?
  candleOpen     Float?
  candleHigh     Float?
  candleLow      Float?
  insufficientData Boolean @default(true)
  lastUpdated    DateTime @default(now())
}

model Signal {
  id                   Int      @id @default(autoincrement())
  ticker               String
  evaluatedAt          DateTime @default(now())
  status               String   // WAIT / BUY_SETUP / BUY_CONFIRMED / HOLD / EXIT / EXTENDED
  distanceFromMA150Pct Float?
  setupScore           Int?
  entryPriceLow        Float?
  entryPriceHigh       Float?
  suggestedStop        Float?
  reasonJson           String   // JSON string של תנאים PASS/FAIL + הסבר
}

model Position {
  id           Int      @id @default(autoincrement())
  ticker       String
  shares       Int
  entryPrice   Float
  entryDate    DateTime
  initialStop  Float
  currentStop  Float
  notes        String?
  status       String   @default("OPEN") // OPEN / CLOSED
  exitPrice    Float?
  closedAt     DateTime?
  createdAt    DateTime @default(now())

  history      PositionHistory[]
}

model PositionHistory {
  id         Int      @id @default(autoincrement())
  positionId Int
  changedAt  DateTime @default(now())
  field      String   // "stop" | "status" | ...
  oldValue   String?
  newValue   String?

  position   Position @relation(fields: [positionId], references: [id])
}

model TradeHistory {
  id         Int      @id @default(autoincrement())
  ticker     String
  entryPrice Float
  exitPrice  Float
  shares     Int
  pnlDollar  Float
  pnlPct     Float
  entryDate  DateTime
  exitDate   DateTime
  holdDays   Int
}
